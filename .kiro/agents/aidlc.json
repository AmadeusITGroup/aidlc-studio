  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun (run )?[\"']?\\.kiro/tools/[A-Za-z0-9._-]+\\.ts[\"']?( .*)?",
        "date -u( .*)?",
        "mktemp( .*)?",
        "git clone( .*)?",
        "git( -C [^\\s]+)? (ls-remote|rev-parse|ls-files|log|show|cat-file|for-each-ref|symbolic-ref)( .*)?"
      ],
      "deniedCommands": [
        "([^\\s]*/)?rm( [^\\s]+)* -[A-Za-z]*[rR][A-Za-z]*( .*)?",
        "([^\\s]*/)?rm( [^\\s]+)* --recursive( .*)?",
        "([^\\s]*/)?git( -[^\\s]+( (\"[^\"]*\"|'[^']*'|[^\\s]+))?)* push( .*)?"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/spaces/**",
        ".kiro/sensors/**",
        "aidlc/.aidlc-compose-pending"
      ]
    },
    "subagent": {
