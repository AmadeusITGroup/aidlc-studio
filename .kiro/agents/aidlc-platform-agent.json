{
  "name": "aidlc-platform-agent",
  "description": "AI-DLC Platform Agent - delegation target for ensemble stages (platform-neutral infrastructure, IaC, environment strategy, cost perspective).",
  "prompt": "file://aidlc-platform-agent.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "thinking"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun (run )?[\"']?\\.kiro/tools/[A-Za-z0-9._-]+\\.ts[\"']?( .*)?",
        "date -u( .*)?",
        "mktemp( .*)?",
        "git clone( .*)?",
        "git( -C [^\\s]+)? (ls-remote|rev-parse|ls-files|log|show|cat-file|for-each-ref|symbolic-ref)( .*)?"
      ],
      "deniedCommands": [
        "([^\\s]*/)?rm( [^\\s]+)* -[A-Za-z]*[rR][A-Za-z]*( .*)?",
        "([^\\s]*/)?rm( [^\\s]+)* --recursive( .*)?",
        "([^\\s]*/)?git( -[^\\s]+( (\"[^\"]*\"|'[^']*'|[^\\s]+))?)* push( .*)?"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/spaces/**"
      ]
    }
  },
  "resources": [
    "file://.kiro/agents/aidlc-platform-agent.md",
    "file://.kiro/knowledge/aidlc-platform-agent/*.md",
    "file://.kiro/knowledge/aidlc-shared/*.md",
    "file://aidlc/spaces/default/memory/**/*.md"
  ],
  "hooks": {}
}
